import streamlit as st
import pandas as pd
import plotly.express as px

# 1. 페이지 설정
st.set_page_config(
    page_title="영화 데이터 그래프 도감 1 - 시간",
    layout="wide",
    initial_sidebar_state="expanded"
)

# 2. 데이터 로드 및 전처리 (캐싱 적용)
@st.cache_data
def load_data():
    url = "https://raw.githubusercontent.com/greatsong/modudata/main/data/kobis_daily.csv"
    df = pd.read_csv(url)
    
    # '날짜' 열을 문자열로 변환 후, datetime 객체로 변환 (예: 20230101 -> 2023-01-01)
    df['날짜'] = pd.to_datetime(df['날짜'].astype(str), format='%Y%m%d')
    return df

try:
    df = load_data()
except Exception as e:
    st.error(f"데이터를 불러오는 중 오류가 발생했습니다: {e}")
    st.stop()

# 3. 사이드바 - 구역(메뉴) 나누기
st.sidebar.title("목차")
menu = st.sidebar.radio(
    "원하는 그래프 구역을 선택하세요:",
    ["1. 영화별 일관객 변화 추이", "2. 추후 추가 예정 구역"]
)

# 4. 메인 화면 타이틀
st.title("🎬 영화 데이터 그래프 도감 1 - 시간")
st.caption("1년치(365일) 일별 박스오피스 10위권 기록 데이터 분석")
st.markdown("---")

# 5. 구역별 콘텐츠 렌더링
if menu == "1. 영화별 일관객 변화 추이":
    st.header("📈 영화별 일관객 변화 추이")
    st.subheader("영화를 선택하여 날짜별 일관객 수의 변화를 확인하세요.")
    
    # 영화 목록 추출 및 선택 드롭다운 (가나다순 정렬)
    movie_list = sorted(df['영화명'].unique())
    selected_movie = st.selectbox("🎥 영화를 선택하세요", movie_list)
    
    # 선택된 영화의 데이터 필터링 및 날짜순 정렬
    movie_df = df[df['영화명'] == selected_movie].sort_values(by='날짜')
    
    # 플롯리(Plotly) 선 그래프 생성
    fig = px.line(
        movie_df, 
        x='날짜', 
        y='일관객', 
        title=f"[{selected_movie}] 일관객수 변화",
        labels={'날짜': '상영 날짜', '일관객': '일일 관객 수(명)'},
        markers=True  # 데이터 포인트를 표시하여 마우스 호버를 쉽게 만듦
    )
    
    # 호버 툴팁 스타일 설정 (날짜와 관객수 명시)
    fig.update_traces(
        hovertemplate="<b>날짜:</b> %{x}<br><b>관객수:</b> %{y:,.0f}명<extra></extra>"
    )
    
    # 레이아웃 조정
    fig.update_layout(
        hovermode="x unified",
        xaxis_tickformat="%Y-%m-%d"
    )
    
    # 스트림릿에 그래프 출력
    st.plotly_chart(fig, use_container_width=True)
    
    # 내가 작성할 문구 자리 (수정 가능한 텍스트 입력창 혹은 텍스트 박스로 배치)
    st.markdown("#### 💡 이 그래프로 알 수 있는 것")
    st.info("이곳에 분석 내용을 작성하세요. (예: 주말마다 관객 수가 급증하는 패턴을 보입니다.)")

elif menu == "2. 추후 추가 예정 구역":
    st.header("⏳ 새로운 그래프 준비 중")
    st.write("앞으로 추가될 데이터 시각화 구역입니다.")
    st.markdown("#### 💡 이 그래프로 알 수 있는 것")
    st.info("이곳에 새로운 그래프의 분석 내용이 들어갈 예정입니다.")
